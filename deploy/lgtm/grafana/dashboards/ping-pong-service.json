      "transparent": true,
      "options": {
        "content": "<div style=\"display: flex; justify-content: space-between; align-items: center; background: #181b1f; padding: 6px 14px; border-radius: 6px; border: 1px solid #2b303c;\">\n  <div style=\"display: flex; gap: 8px; align-items: center; font-size: 13px;\">\n    <span style=\"color: #8e94a0; font-weight: 600; margin-right: 6px;\">Suite Navigator:</span>\n    <a href=\"/d/nats-otel-overview\" style=\"background: #22252b; color: #c7d0d9; padding: 4px 10px; border-radius: 4px; text-decoration: none;\">1. Overview</a>\n    <a href=\"/d/nats-broker-metrics\" style=\"background: #22252b; color: #c7d0d9; padding: 4px 10px; border-radius: 4px; text-decoration: none;\">2. Broker Metrics</a>\n    <a href=\"/d/nats-wiretap-traces\" style=\"background: #22252b; color: #c7d0d9; padding: 4px 10px; border-radius: 4px; text-decoration: none;\">3. Wiretap Traces</a>\n    <a href=\"/d/nats-logs-and-events\" style=\"background: #22252b; color: #c7d0d9; padding: 4px 10px; border-radius: 4px; text-decoration: none;\">4. Logs & Events</a>\n    <a href=\"/d/nats-ping-pong-service\" style=\"background: #3274D9; color: #ffffff; padding: 4px 10px; border-radius: 4px; font-weight: bold; text-decoration: none;\">● 5. Ping-Pong App (Active)</a>\n  </div>\n  <div>\n    <a href=\"/d/nats-otel-overview\" style=\"background: #3274D9; color: #ffffff; padding: 5px 12px; border-radius: 4px; font-weight: bold; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;\">↺ Return to Overview</a>\n  </div>\n</div>",
        "mode": "html"
